{
  "name": "jquery-field-compare-string",
  "version": "1.1.0",
  "description": "jQuery Field Compare String - jQuery plugin to compare the value of an input[type=text] or textarea to the string of text contained by an html element.",
  "author": "Copyright (c) 2017-2026 Luis Luz - UXD Lda <dev@uxd.pt>",
  "license": "MIT",
  "keywords": [
    "jquery-plugin",
    "ecosystem:jquery"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:lluz/jquery-field-compare-string.git"
  },
  "homepage": "https://github.com/lluz/jquery-field-compare-string",
  "bugs": {
    "url": "https://github.com/lluz/jquery-field-compare-string/issues"
  },
  "main": "dist/js/jquery.jFieldCompareString.js",
  "files": [
    "dist/js/jquery.jFieldCompareString.js"
  ],
  "devDependencies": {
    "adm-zip": "^0.6.0",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.0",
    "serve": "^14.2.4"
  },
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "esbuild dist/js/jquery.jFieldCompareString.js --minify --legal-comments=inline --outfile=dist/js/jquery.jFieldCompareString.min.js",
    "build:css": "esbuild dist/css/jquery.jFieldCompareString.css --minify --outfile=dist/css/jquery.jFieldCompareString.min.css",
    "dev_start": "concurrently \"npm run build:js -- --watch\" \"npm run build:css -- --watch\"",
    "server_start": "concurrently \"npm run dev_start\" \"serve dist -l 7777 --no-clipboard\"",
    "compress_dist": "node scripts/compress-dist.mjs"
  }
}
